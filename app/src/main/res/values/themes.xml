<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 시작 화면 깜박임을 막기 위해 창 배경을 Pleos background_primary로 맞춘다. 낮/밤은 차량 설정을 따른다. -->
    <style name="Theme.Shimpyo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pleos_background_primary</item>
        <item name="android:statusBarColor">@color/pleos_background_primary</item>
        <item name="android:navigationBarColor">@color/pleos_background_primary</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
